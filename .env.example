# --- Instagram (App Dashboard > Instagram > API setup with Instagram Login) ---
IG_USER_ID=
# IG_ACCESS_TOKEN só é usado no bootstrap; depois fica cifrado na BD e podes apagá-lo daqui
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_API_VERSION=v25.0
# Os quatro segredos seguintes saem de: python scripts/gen_key.py
WEBHOOK_VERIFY_TOKEN=
ENCRYPTION_KEY=
ADMIN_API_KEY=
TELEGRAM_WEBHOOK_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=
MODEL_CLASSIFY=claude-haiku-5-5
MODEL_DRAFT=claude-sonnet-5-5
# legendas dos posts
MODEL_CONTENT=claude-opus-5-5

# --- Infra (valores para o docker-compose; em local: sqlite:///./agent.db e redis://localhost:6379/0) ---
# Muda a palavra-passe (POSTGRES_PASSWORD) e usa a mesma no DATABASE_URL
POSTGRES_PASSWORD=agent
DATABASE_URL=postgresql+psycopg2://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0

# --- Telegram (cria o bot com o @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Comportamento ---
# approval = tudo passa por ti no Telegram; auto = segue a política (só depois de semanas em approval)
AUTONOMY_MODE=approval
MAX_POSTS_PER_DAY=3
MAX_COMMENT_REPLIES_PER_HOUR=30
MAX_DMS_PER_HOUR=60
REPLY_DELAY_MIN_S=120
REPLY_DELAY_MAX_S=1200
ALLOWED_DOMAINS=apexpt.app

# --- Produção no Raspberry Pi ---
# Cloudflare Zero Trust > Networks > Tunnels > token do túnel (ver docs/RASPBERRY_PI.md)
CLOUDFLARE_TUNNEL_TOKEN=
# endereço público do agente: a Meta descarrega os ficheiros dos posts de <isto>/media/...
PUBLIC_BASE_URL=https://agente.apexpt.app
# Teste local: true. Produção: false
DRY_RUN=false
POST_APPROVAL=true
